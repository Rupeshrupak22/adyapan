# ─── BACKEND ENV EXAMPLE ──────────────────────────────────────────────────────
# Copy this file to .env and fill in your values
# NEVER commit .env to git

# ── Environment ───────────────────────────────────────────────────────────────
NODE_ENV=production

# ── App ───────────────────────────────────────────────────────────────────────
APP_URL=https://yourdomain.com
FRONTEND_URL=https://yourdomain.com

# ── Database ──────────────────────────────────────────────────────────────────
MONGODB_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/dbname
MONGO_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/dbname
DB_NAME=adyapan

# ── Authentication ────────────────────────────────────────────────────────────
# Must match frontend JWT_SECRET
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
COOKIE_SECRET=

# ── Admin ─────────────────────────────────────────────────────────────────────
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_LOGIN_EMAIL=admin@yourdomain.com
ADMIN_ACCESS_KEY_HASH=
ADMIN_PASS=

# ── Razorpay (FULL keys — never expose secret to frontend) ────────────────────
# Get from: https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=
# Set in Razorpay Dashboard → Webhooks → Secret
RAZORPAY_WEBHOOK_SECRET=

# ── Email (SendGrid) ──────────────────────────────────────────────────────────
# Get from: https://app.sendgrid.com/settings/api_keys
SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxxxxxxxxxx

# ── Email (Gmail SMTP fallback) ───────────────────────────────────────────────
# Use Gmail App Password (NOT account password)
# Generate at: https://myaccount.google.com/apppasswords
EMAIL_FROM=support@yourdomain.com
EMAIL_PASS=

# ── SMS (Fast2SMS) ────────────────────────────────────────────────────────────
# Get from: https://www.fast2sms.com/dashboard
FAST2SMS_API_KEY=
