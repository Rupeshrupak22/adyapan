# Adyapan backend environment template
# Copy to backend/.env for local Express backend development.
# On Render, add these in the service Environment tab.
# Keep real values out of Git.

# Runtime
NODE_ENV=development
PORT=5000
BACKEND_PORT=5000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# MongoDB Atlas
# MONGODB_URI and MONGO_URI can use the same Atlas connection string.
MONGODB_URI=mongodb+srv://placeholder_user:placeholder_password@placeholder-cluster.mongodb.net/adyapan?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://placeholder_user:placeholder_password@placeholder-cluster.mongodb.net/adyapan?retryWrites=true&w=majority
DB_NAME=adyapan

# Authentication and cookies
JWT_SECRET=replace_with_random_64_hex_characters_minimum
COOKIE_SECRET=replace_with_random_64_hex_characters_minimum

# Admin / superadmin
ADMIN_EMAIL=admin@example.com
ADMIN_NAME=Adyapan Superadmin
ADMIN_PASSWORD=replace_with_strong_admin_password
ADMIN_ACCESS_KEY=replace_with_random_admin_access_key

# Optional aliases used by backend/scripts/createSuperAdmin.js
SA_EMAIL=admin@example.com
SA_NAME=Adyapan Superadmin
SA_PASSWORD=replace_with_strong_superadmin_password

# Razorpay
RAZORPAY_KEY_ID=rzp_test_placeholder_key_id
RAZORPAY_KEY_SECRET=razorpay_secret_placeholder
RAZORPAY_WEBHOOK_SECRET=razorpay_webhook_secret_placeholder

# SendGrid email
SENDGRID_API_KEY=SG.placeholder_sendgrid_api_key
EMAIL_FROM=support@adyapan.com
EMAIL_PASS=optional_smtp_password_if_used
